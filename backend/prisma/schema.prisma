generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Rol {
  ADMIN
  EMPLEADO
}

enum EstadoCaptura {
  PENDIENTE
  COMPLETADO
}

enum EstadoSesion {
  ACTIVA
  CERRADA
}

model Usuario {
  id                    String       @id @default(uuid())
  nombre                String
  // username será el identificador principal para iniciar sesión.
  // Se deja opcional durante la transición para no romper registros históricos existentes.
  username              String?      @unique
  email                 String?      @unique
  // Campo legado. Ya NO se usa para autenticar y se limpia con scripts/prepareSecurity.js.
  password              String?
  passwordHash          String?
  rol                   Rol          @default(EMPLEADO)
  activo                Boolean      @default(true)
  debeCambiarPassword   Boolean      @default(true)
  lastLoginAt           DateTime?
  passwordChangedAt     DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  capturas              Captura[]
  sesionesAuth          SesionAuth[]
}

model SesionAuth {
  id          String   @id @default(uuid())
  tokenHash   String   @unique
  usuarioId   String
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  revocadaAt  DateTime?
  userAgent   String?
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  @@index([usuarioId])
  @@index([expiresAt])
}

model Producto {
  id        String   @id @default(uuid())
  codigo    String   @unique
  nombre    String
  precio    Float    @default(0.0)
  stock     Int      @default(0)
  seccion   String?  // Pasillo 1, Refri 2, Mostrador, etc.
  categoria String?  // Departamento del POS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  capturas  Captura[]
}

model SesionInventario {
  id          String       @id @default(uuid())
  nombre      String       // Ej. "Inventario General Agosto 2026"
  estado      EstadoSesion @default(ACTIVA)
  fechaInicio DateTime     @default(now())
  fechaFin    DateTime?
  capturas    Captura[]
}

model Captura {
  id               String           @id @default(uuid())
  productoId       String
  producto         Producto         @relation(fields: [productoId], references: [id], onDelete: Cascade)
  usuarioId        String
  // Restrict protege la trazabilidad: un usuario con capturas no debe borrarse físicamente.
  usuario          Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  sesionId         String
  sesion           SesionInventario @relation(fields: [sesionId], references: [id], onDelete: Cascade)

  cantidadFisica   Int              // Conteo enviado por la empleada
  stockSicar       Int?             // Cifra vigente del POS ingresada manualmente por el Admin
  diferencia       Int?             // cantidadFisica - stockSicar
  estado           EstadoCaptura    @default(PENDIENTE)
  seccionCapturada String?          // Zona específica donde se contó

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}
